{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "local-git-issues",
  "version": "0.1.0",
  "identifier": "com.local.git.issues",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Local Git Issues",
        "width": 1200,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "maximized": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all"
  }
}